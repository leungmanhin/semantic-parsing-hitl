**/__pycache__/
*.pyc

mini-reports/

# public datasets: the fetch script, the README and each SOURCE.json are versioned, the data is not
datasets/*/*
!datasets/*/SOURCE.json
!datasets/sample/*.jsonl
!datasets/sample/COVERAGE.md
!datasets/sample/coverage.json

# mining runs: the large per-run outputs are regenerable (python -m fusenf.mine lift / patterns …); the summaries stay
fusenf/runs/*/graphs.jsonl
fusenf/runs/*/lifted.jsonl
fusenf/runs/*/presence.jsonl
fusenf/runs/*/patterns.*.jsonl
