;; The CLOSURE stage of the catalog's background rules (rules.yaml `closures`), UNROLLED for our engine line —
;; generated by `python -m tmpl.rules`; never edited by hand. The source states each closure as recursive rules;
;; here every closure head carries a depth (0 for a base conclusion, one more per composition, below the closure's
;; bound) and each converse rule is folded into the rules it reads from, so no rule's conclusion feeds its own
;; premises. These rules are FORWARD-CHAINED ONCE over a text's statements, with the lexicon facts of
;; seeded_rules.metta, before a question is asked; what they derive is loaded beside the statements, and the
;; question is asked with seeded_rules.metta alone (a closure rule beside its own conclusions would count them
;; twice). A workaround for our engine line (tmpl.reason), to re-test after the switch to upstream PeTTaChainer.

;; kin_lift: a stated state whose class is a kinship word is that kinship relation between its bearer and its theme (reads: stative-relation)
(: kin_lift (Implication (And (KinGeneral $w $n) (Member $s $w) (Bearer $s $x) (Theme $s $y)) (KinWord $w $x $y)) (CTV (STV 1.0 0.99) (STV 0.0 0.0)))
;; kin_lift_two: a kinship state with two bearers (siblings, spouses, cousins) relates each bearer to the other (reads: stative-relation)
(: kin_lift_two (Implication (And (KinSymmetric $w) (Member $s $w) (Bearer $s $x) (Bearer $s $y) (Compute != ($x $y) -> true)) (KinWord $w $x $y)) (CTV (STV 1.0 0.99) (STV 0.0 0.0)))
;; kin_gender: a gendered kinship word gives its bearer that gender (his daughter Valerie - Valerie is female) (reads: stative-relation)
(: kin_gender (Implication (And (KinGender $w $g) (KinWord $w $x $y)) (Member $x $g)) (CTV (STV 1.0 0.99) (STV 0.0 0.0)))
;; kin_stated: a stated kinship relation in its neutral word (reads: stative-relation)
(: kin_stated (Implication (And (KinGeneral $w $n) (KinWord $w $x $y)) (Kin 0 $n $x $y)) (CTV (STV 1.0 0.99) (STV 0.0 0.0)))
;; kin_stated_converse: a stated kinship relation in its neutral word — read the other way round (a kinship relation read from the other side (x is y's child - y is x's parent)) (reads: stative-relation)
(: kin_stated_converse (Implication (And (KinGeneral $w $n) (KinConverse $n $c) (KinWord $w $x $y)) (Kin 0 $c $y $x)) (CTV (STV 1.0 0.99) (STV 0.0 0.0)))
;; kin_compose: x is y's A and y is z's B, so x is z's C (a sibling of a parent is an aunt or an uncle) (reads: stative-relation)
(: kin_compose (Implication (And (KinCompose $a $b $c) (Kin $d $a $x $y) (Kin 0 $b $y $z) (Compute + ($d 1) -> $e) (Compute < ($e 4) -> true)) (Kin $e $c $x $z)) (CTV (STV 1.0 0.99) (STV 0.0 0.0)))
;; kin_compose_converse: x is y's A and y is z's B, so x is z's C (a sibling of a parent is an aunt or an uncle) — read the other way round (a kinship relation read from the other side (x is y's child - y is x's parent)) (reads: stative-relation)
(: kin_compose_converse (Implication (And (KinCompose $a $b $c) (KinConverse $c $f) (Kin $d $a $x $y) (Kin 0 $b $y $z) (Compute + ($d 1) -> $e) (Compute < ($e 4) -> true)) (Kin $e $f $z $x)) (CTV (STV 1.0 0.99) (STV 0.0 0.0)))
;; kin_compose_distinct: a composition that could return to its start (two children of one parent are siblings), drawn only between two named people with different names (reads: stative-relation, named-entity)
(: kin_compose_distinct (Implication (And (KinComposeDistinct $a $b $c) (Kin $d $a $x $y) (Kin 0 $b $y $z) (Name $x $nx) (Name $z $nz) (Compute + ($d 1) -> $e) (Compute < ($e 4) -> true) (Compute != ($nx $nz) -> true)) (Kin $e $c $x $z)) (CTV (STV 1.0 0.99) (STV 0.0 0.0)))
;; kin_compose_distinct_converse: a composition that could return to its start (two children of one parent are siblings), drawn only between two named people with different names — read the other way round (a kinship relation read from the other side (x is y's child - y is x's parent)) (reads: stative-relation, named-entity)
(: kin_compose_distinct_converse (Implication (And (KinComposeDistinct $a $b $c) (KinConverse $c $f) (Kin $d $a $x $y) (Kin 0 $b $y $z) (Name $x $nx) (Name $z $nz) (Compute + ($d 1) -> $e) (Compute < ($e 4) -> true) (Compute != ($nx $nz) -> true)) (Kin $e $f $z $x)) (CTV (STV 1.0 0.99) (STV 0.0 0.0)))
;; kin_compose_default: a composition that usually holds, at a lower strength a later fact can overturn (a sibling's parent is one's own; a spouse's child is one's own) (reads: stative-relation)
(: kin_compose_default (Implication (And (KinComposeDefault $a $b $c) (Kin $d $a $x $y) (Kin 0 $b $y $z) (Compute + ($d 1) -> $e) (Compute < ($e 4) -> true)) (Kin $e $c $x $z)) (CTV (STV 0.9 0.9) (STV 0.0 0.0)))
;; kin_compose_default_converse: a composition that usually holds, at a lower strength a later fact can overturn (a sibling's parent is one's own; a spouse's child is one's own) — read the other way round (a kinship relation read from the other side (x is y's child - y is x's parent)) (reads: stative-relation)
(: kin_compose_default_converse (Implication (And (KinComposeDefault $a $b $c) (KinConverse $c $f) (Kin $d $a $x $y) (Kin 0 $b $y $z) (Compute + ($d 1) -> $e) (Compute < ($e 4) -> true)) (Kin $e $f $z $x)) (CTV (STV 0.9 0.9) (STV 0.0 0.0)))
;; kin_compose_default_distinct: a default composition between two named people with different names (the two parents of one child are spouses) (reads: stative-relation, named-entity)
(: kin_compose_default_distinct (Implication (And (KinComposeDefaultDistinct $a $b $c) (Kin $d $a $x $y) (Kin 0 $b $y $z) (Name $x $nx) (Name $z $nz) (Compute + ($d 1) -> $e) (Compute < ($e 4) -> true) (Compute != ($nx $nz) -> true)) (Kin $e $c $x $z)) (CTV (STV 0.9 0.9) (STV 0.0 0.0)))
;; kin_compose_default_distinct_converse: a default composition between two named people with different names (the two parents of one child are spouses) — read the other way round (a kinship relation read from the other side (x is y's child - y is x's parent)) (reads: stative-relation, named-entity)
(: kin_compose_default_distinct_converse (Implication (And (KinComposeDefaultDistinct $a $b $c) (KinConverse $c $f) (Kin $d $a $x $y) (Kin 0 $b $y $z) (Name $x $nx) (Name $z $nz) (Compute + ($d 1) -> $e) (Compute < ($e 4) -> true) (Compute != ($nx $nz) -> true)) (Kin $e $f $z $x)) (CTV (STV 0.9 0.9) (STV 0.0 0.0)))
