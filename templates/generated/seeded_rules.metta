;; ===== Rules =====
;; result_holds: a change's named result holds afterwards (reads: change-of-state)
(: result_holds (Implication (Result $e (Member $x $s)) (Member $x $s)) (CTV (STV 1.0 0.9) (STV 0.0 0.0)))
;; between_sym: between a and b is between b and a (reads: oblique, postmodifier, locative, location)
(: between_sym (Equivalence (Between $x $a $b) (Between $x $b $a)) (STV 1.0 0.99))
;; coref_sym: a coreference link holds in both directions (reads: coref)
(: coref_sym (Equivalence (Coref $a $b) (Coref $b $a)) (STV 1.0 0.99))
;; coref_agent: a mention's Agent role holds of its antecedent (reads: coref)
(: coref_agent (Implication (And (Coref $m $a) (Agent $e $m)) (Agent $e $a)) (CTV (STV 1.0 0.99) (STV 0.0 0.0)))
;; coref_patient: a mention's Patient role holds of its antecedent (reads: coref)
(: coref_patient (Implication (And (Coref $m $a) (Patient $e $m)) (Patient $e $a)) (CTV (STV 1.0 0.99) (STV 0.0 0.0)))
;; coref_theme: a mention's Theme role holds of its antecedent (reads: coref)
(: coref_theme (Implication (And (Coref $m $a) (Theme $e $m)) (Theme $e $a)) (CTV (STV 1.0 0.99) (STV 0.0 0.0)))
;; coref_recipient: a mention's Recipient role holds of its antecedent (reads: coref)
(: coref_recipient (Implication (And (Coref $m $a) (Recipient $e $m)) (Recipient $e $a)) (CTV (STV 1.0 0.99) (STV 0.0 0.0)))
;; coref_experiencer: a mention's Experiencer role holds of its antecedent (reads: coref)
(: coref_experiencer (Implication (And (Coref $m $a) (Experiencer $e $m)) (Experiencer $e $a)) (CTV (STV 1.0 0.99) (STV 0.0 0.0)))
;; coref_bearer: a mention's Bearer role holds of its antecedent (reads: coref)
(: coref_bearer (Implication (And (Coref $m $a) (Bearer $e $m)) (Bearer $e $a)) (CTV (STV 1.0 0.99) (STV 0.0 0.0)))
;; coref_stimulus: a mention's Stimulus role holds of its antecedent (reads: coref)
(: coref_stimulus (Implication (And (Coref $m $a) (Stimulus $e $m)) (Stimulus $e $a)) (CTV (STV 1.0 0.99) (STV 0.0 0.0)))
;; coref_holder: a mention's Holder role holds of its antecedent (reads: coref)
(: coref_holder (Implication (And (Coref $m $a) (Holder $e $m)) (Holder $e $a)) (CTV (STV 1.0 0.99) (STV 0.0 0.0)))
;; coref_goal: a mention's Goal role holds of its antecedent (reads: coref)
(: coref_goal (Implication (And (Coref $m $a) (Goal $e $m)) (Goal $e $a)) (CTV (STV 1.0 0.99) (STV 0.0 0.0)))
;; coref_source: a mention's Source role holds of its antecedent (reads: coref)
(: coref_source (Implication (And (Coref $m $a) (Source $e $m)) (Source $e $a)) (CTV (STV 1.0 0.99) (STV 0.0 0.0)))
;; coref_location: a mention's Location role holds of its antecedent (reads: coref)
(: coref_location (Implication (And (Coref $m $a) (Location $e $m)) (Location $e $a)) (CTV (STV 1.0 0.99) (STV 0.0 0.0)))
;; coref_member: a mention's class or property holds of its antecedent (reads: coref)
(: coref_member (Implication (And (Coref $m $a) (Member $m $k)) (Member $a $k)) (CTV (STV 1.0 0.99) (STV 0.0 0.0)))
;; coref_possession: what a mention possesses, its antecedent possesses (reads: coref)
(: coref_possession (Implication (And (Coref $m $a) (Possession $x $m)) (Possession $x $a)) (CTV (STV 1.0 0.99) (STV 0.0 0.0)))
;; coref_locatedin: where a mention is, its antecedent is (reads: coref)
(: coref_locatedin (Implication (And (Coref $m $a) (LocatedIn $m $p)) (LocatedIn $a $p)) (CTV (STV 1.0 0.99) (STV 0.0 0.0)))
;; days_before_day: a time n days before an anchor has the anchor's day number minus n (reads: time, reference-time)
(: days_before_day (Implication (And (BeforeBy $t $a $n day) (Day $a $d) (Compute - ($d $n) -> $e)) (Day $t $e)) (CTV (STV 1.0 0.99) (STV 0.0 0.0)))
;; days_after_day: a time n days after an anchor has the anchor's day number plus n (reads: time, reference-time)
(: days_after_day (Implication (And (BeforeBy $a $t $n day) (Day $a $d) (Compute + ($d $n) -> $e)) (Day $t $e)) (CTV (STV 1.0 0.99) (STV 0.0 0.0)))
;; days_before_month: a time some days before an anchor is in the anchor's month (reads: time, reference-time)
(: days_before_month (Implication (And (BeforeBy $t $a $n day) (Month $a $m)) (Month $t $m)) (CTV (STV 1.0 0.9) (STV 0.0 0.0)))
;; days_before_year: a time some days before an anchor is in the anchor's year (reads: time, reference-time)
(: days_before_year (Implication (And (BeforeBy $t $a $n day) (Year $a $y)) (Year $t $y)) (CTV (STV 1.0 0.9) (STV 0.0 0.0)))
;; days_after_month: a time some days after an anchor is in the anchor's month (reads: time, reference-time)
(: days_after_month (Implication (And (BeforeBy $a $t $n day) (Month $a $m)) (Month $t $m)) (CTV (STV 1.0 0.9) (STV 0.0 0.0)))
;; days_after_year: a time some days after an anchor is in the anchor's year (reads: time, reference-time)
(: days_after_year (Implication (And (BeforeBy $a $t $n day) (Year $a $y)) (Year $t $y)) (CTV (STV 1.0 0.9) (STV 0.0 0.0)))
;; weekday_class: a time instance with a weekday field is a member of that weekday's class (reads: time)
(: weekday_class (Implication (Weekday $t $w) (Member $t $w)) (CTV (STV 1.0 0.99) (STV 0.0 0.0)))
;; month_class: a time instance with a month field is a member of that month's class (reads: time)
(: month_class (Implication (Month $t $m) (Member $t $m)) (CTV (STV 1.0 0.99) (STV 0.0 0.0)))
;; more_trans: exceeding is transitive on a scale (reads: comparative)
(: more_trans (Implication (And (More $s $x $y) (More $s $y $z)) (More $s $x $z)) (CTV (STV 1.0 0.99) (STV 0.0 0.0)))
;; samedegree_sym: an equative holds in both directions (reads: comparative)
(: samedegree_sym (Equivalence (SameDegree $s $x $y) (SameDegree $s $y $x)) (STV 1.0 0.99))
;; morebydiff: a measured gap entails the plain ordering (reads: comparative)
(: morebydiff (Implication (MoreBy $s $x $y $n $u) (More $s $x $y)) (CTV (STV 1.0 0.99) (STV 0.0 0.0)))
;; morebydiff_trans: measured gaps add along a chain in one unit (reads: comparative)
(: morebydiff_trans (Implication (And (MoreBy $s $x $y $a $u) (MoreBy $s $y $z $b $u) (Compute + ($a $b) -> $c)) (MoreBy $s $x $z $c $u)) (CTV (STV 1.0 0.99) (STV 0.0 0.0)))
;; ratio_more_gt: a factor above one entails the plain ordering (reads: comparative)
(: ratio_more_gt (Implication (And (TimesAs $s $x $y $f) (Compute > ($f 1) -> true)) (More $s $x $y)) (CTV (STV 1.0 0.99) (STV 0.0 0.0)))
;; ratio_more_lt: a factor below one entails the reverse ordering (reads: comparative)
(: ratio_more_lt (Implication (And (TimesAs $s $x $y $f) (Compute < ($f 1) -> true)) (More $s $y $x)) (CTV (STV 1.0 0.99) (STV 0.0 0.0)))
;; so_sym: the poles of a dimension are opposite in both directions (reads: comparative)
(: so_sym (Equivalence (ScaleOpposite $a $b) (ScaleOpposite $b $a)) (STV 1.0 0.99))
;; pole_more: exceeding on one pole is being exceeded on the opposite pole (reads: comparative)
(: pole_more (Implication (And (ScaleOpposite $a $b) (More $a $x $y)) (More $b $y $x)) (CTV (STV 1.0 0.99) (STV 0.0 0.0)))
;; pole_moreby: a measured gap on one pole is the same gap the other way on the opposite pole (reads: comparative)
(: pole_moreby (Implication (And (ScaleOpposite $a $b) (MoreBy $a $x $y $n $u)) (MoreBy $b $y $x $n $u)) (CTV (STV 1.0 0.99) (STV 0.0 0.0)))
;; pole_samedegree: an equative on one pole is an equative on the opposite pole (reads: comparative)
(: pole_samedegree (Implication (And (ScaleOpposite $a $b) (SameDegree $a $x $y)) (SameDegree $b $x $y)) (CTV (STV 1.0 0.99) (STV 0.0 0.0)))
;; unit_measure: a measure in a unit with a factor holds in the canonical unit (reads: measure)
(: unit_measure (Implication (And (Measure $x $d $n $u) (UnitFactor $u $c $f) (Compute * ($n $f) -> $m)) (Measure $x $d $m $c)) (CTV (STV 1.0 0.99) (STV 0.0 0.0)))
;; unit_atleast: a lower bound converts like a measure (reads: measure)
(: unit_atleast (Implication (And (MeasureAtLeast $x $d $n $u) (UnitFactor $u $c $f) (Compute * ($n $f) -> $m)) (MeasureAtLeast $x $d $m $c)) (CTV (STV 1.0 0.99) (STV 0.0 0.0)))
;; unit_atmost: an upper bound converts like a measure (reads: measure)
(: unit_atmost (Implication (And (MeasureAtMost $x $d $n $u) (UnitFactor $u $c $f) (Compute * ($n $f) -> $m)) (MeasureAtMost $x $d $m $c)) (CTV (STV 1.0 0.99) (STV 0.0 0.0)))
;; unit_moreby: a measured gap converts to the canonical unit (reads: comparative)
(: unit_moreby (Implication (And (MoreBy $s $x $y $n $u) (UnitFactor $u $c $f) (Compute * ($n $f) -> $m)) (MoreBy $s $x $y $m $c)) (CTV (STV 1.0 0.99) (STV 0.0 0.0)))
;; measure_moreby: two measures on one dimension in one unit give the gap between the things (reads: measure, comparative)
(: measure_moreby (Implication (And (Measure $x $d $a $u) (Measure $y $d $b $u) (Compute - ($a $b) -> $g) (Compute > ($g 0) -> true)) (MoreBy $d $x $y $g $u)) (CTV (STV 1.0 0.99) (STV 0.0 0.0)))
;; measure_same: equal measures on one dimension in one unit give the equative (reads: measure, comparative)
(: measure_same (Implication (And (Measure $x $d $a $u) (Measure $y $d $a $u) (Compute != ($x $y) -> true)) (SameDegree $d $x $y)) (CTV (STV 1.0 0.99) (STV 0.0 0.0)))
;; dimension_more: an ordering on a dimension noun is the ordering on its adjective scale (reads: measure, comparative)
(: dimension_more (Implication (And (More $d $x $y) (DimensionScale $d $s)) (More $s $x $y)) (CTV (STV 1.0 0.99) (STV 0.0 0.0)))
;; dimension_moreby: a gap on a dimension noun is the gap on its adjective scale (reads: measure, comparative)
(: dimension_moreby (Implication (And (MoreBy $d $x $y $n $u) (DimensionScale $d $s)) (MoreBy $s $x $y $n $u)) (CTV (STV 1.0 0.99) (STV 0.0 0.0)))
;; dimension_samedegree: an equative on a dimension noun is the equative on its adjective scale (reads: measure, comparative)
(: dimension_samedegree (Implication (And (SameDegree $d $x $y) (DimensionScale $d $s)) (SameDegree $s $x $y)) (CTV (STV 1.0 0.99) (STV 0.0 0.0)))
;; most_exceeds: the most ADJ member of a class exceeds every other member on the scale (reads: superlative, comparative)
(: most_exceeds (Implication (And (Most $s $x $c) (Member $y $c) (Compute != ($x $y) -> true)) (More $s $x $y)) (CTV (STV 1.0 0.99) (STV 0.0 0.0)))
;; year_order: an event whose time is in an earlier year precedes the other (reads: time)
(: year_order (Implication (And (Time $e1 $a) (Year $a $y1) (Time $e2 $b) (Year $b $y2) (Compute < ($y1 $y2) -> true)) (Before $e1 $e2)) (CTV (STV 1.0 0.99) (STV 0.0 0.0)))
;; month_order: within one year, an event in an earlier month precedes the other (reads: time)
(: month_order (Implication (And (Time $e1 $a) (Year $a $y) (Month $a $m1) (Time $e2 $b) (Year $b $y) (Month $b $m2) (MonthIndex $m1 $i) (MonthIndex $m2 $j) (Compute < ($i $j) -> true)) (Before $e1 $e2)) (CTV (STV 1.0 0.99) (STV 0.0 0.0)))
;; day_order: within one month of one year, an event on an earlier day precedes the other (reads: time)
(: day_order (Implication (And (Time $e1 $a) (Year $a $y) (Month $a $m) (Day $a $d1) (Time $e2 $b) (Year $b $y) (Month $b $m) (Day $b $d2) (Compute < ($d1 $d2) -> true)) (Before $e1 $e2)) (CTV (STV 1.0 0.99) (STV 0.0 0.0)))
;; rank_orders: of two ranks on one scale in one class, the lower is the greater (the second largest exceeds the third) (reads: superlative, comparative)
(: rank_orders (Implication (And (Ordinal $a $m $s $c) (Ordinal $b $n $s $c) (Compute < ($m $n) -> true) (Compute != ($s $c) -> true)) (More $s $a $b)) (CTV (STV 1.0 0.99) (STV 0.0 0.0)))
;; most_rank_one: the most ADJ member of a class is first on that scale in that class (reads: superlative)
(: most_rank_one (Implication (Most $s $x $c) (Ordinal $x 1 $s $c)) (CTV (STV 1.0 0.99) (STV 0.0 0.0)))
;; most_bounds: no member of a class exceeds its most ADJ member on the scale (reads: superlative, comparative)
(: most_bounds (Implication (And (Most $s $x $c) (Member $y $c)) (Not (More $s $y $x))) (CTV (STV 1.0 0.99) (STV 0.0 0.0)))
;; counterfactual_antecedent_false: a counterfactual's antecedent did not happen (reads: counterfactual)
(: counterfactual_antecedent_false (Implication (Counterfactual $p $q) (Not $p)) (CTV (STV 1.0 0.9) (STV 0.0 0.0)))
;; felt_state_holds: a transparent felt or complemented state yields the bearer's bare property (reads: sensation, adjective-complement)
(: felt_state_holds (Implication (And (Member $s $p) (Experiencer $s $x) (Transparent $p)) (Member $x $p)) (CTV (STV 1.0 0.9) (STV 0.0 0.0)))
;; subset_is_part: a quantified portion of a group is a part of it (reads: portion)
(: subset_is_part (Implication (SubsetOf $s $g) (PartOf $s $g)) (CTV (STV 1.0 0.99) (STV 0.0 0.0)))
;; partof_trans: a part of a part is a part of the whole (reads: part-whole)
(: partof_trans (Implication (And (PartOf $x $y) (PartOf $y $z)) (PartOf $x $z)) (CTV (STV 1.0 0.9) (STV 0.0 0.0)))
;; part_located: a part is where its whole is (reads: part-whole, locative)
(: part_located (Implication (And (PartOf $p $w) (LocatedIn $w $l)) (LocatedIn $p $l)) (CTV (STV 1.0 0.9) (STV 0.0 0.0)))
;; look_holds: what looks so is taken to be so (reads: evidential)
(: look_holds (Implication (Look $p) $p) (CTV (STV 0.9 0.7) (STV 0.0 0.0)))
;; sound_holds: what sounds so is taken to be so (reads: evidential)
(: sound_holds (Implication (Sound $p) $p) (CTV (STV 0.9 0.7) (STV 0.0 0.0)))
;; feel_holds: what feels so is taken to be so (reads: evidential)
(: feel_holds (Implication (Feel $p) $p) (CTV (STV 0.9 0.7) (STV 0.0 0.0)))
;; smell_holds: what smells so is taken to be so (reads: evidential)
(: smell_holds (Implication (Smell $p) $p) (CTV (STV 0.9 0.7) (STV 0.0 0.0)))
;; taste_holds: what tastes so is taken to be so (reads: evidential)
(: taste_holds (Implication (Taste $p) $p) (CTV (STV 0.9 0.7) (STV 0.0 0.0)))
;; seem_holds: what seems so is taken to be so (reads: evidential)
(: seem_holds (Implication (Seem $p) $p) (CTV (STV 0.9 0.7) (STV 0.0 0.0)))
;; appear_holds: what appears so is taken to be so (reads: evidential)
(: appear_holds (Implication (Appear $p) $p) (CTV (STV 0.9 0.7) (STV 0.0 0.0)))
;; obligation_permits: what is obligatory is permitted (reads: norm)
(: obligation_permits (Implication (Obligated $p) (Permitted $p)) (CTV (STV 1.0 0.99) (STV 0.0 0.0)))
;; theme_entailed: an entailing event's sealed Theme holds, at the event's tense (reads: control, causative, aspectual) — 3 variants, by the matrix event's tense
(: theme_entailed (Implication (And (Entails $m) (Theme $m $c) (Compute clause-event ($c) -> $o)) $c) (CTV (STV 1.0 0.9) (STV 0.0 0.0)))
(: theme_entailed_past (Implication (And (Entails $m) (Theme $m $c) (Past $m) (Compute clause-event ($c) -> $o)) (And $c (Past $o))) (CTV (STV 1.0 0.9) (STV 0.0 0.0)))
(: theme_entailed_future (Implication (And (Entails $m) (Theme $m $c) (Future $m) (Compute clause-event ($c) -> $o)) (And $c (Future $o))) (CTV (STV 1.0 0.9) (STV 0.0 0.0)))
;; theme_precluded: a precluding event's sealed Theme does not hold, at the event's tense (reads: control, causative) — 3 variants, by the matrix event's tense
(: theme_precluded (Implication (And (Precludes $m) (Theme $m $c) (Compute clause-event ($c) -> $o)) (Not $c)) (CTV (STV 1.0 0.9) (STV 0.0 0.0)))
(: theme_precluded_past (Implication (And (Precludes $m) (Theme $m $c) (Past $m) (Compute clause-event ($c) -> $o)) (Not (And $c (Past $o)))) (CTV (STV 1.0 0.9) (STV 0.0 0.0)))
(: theme_precluded_future (Implication (And (Precludes $m) (Theme $m $c) (Future $m) (Compute clause-event ($c) -> $o)) (Not (And $c (Future $o)))) (CTV (STV 1.0 0.9) (STV 0.0 0.0)))
;; becauseof_cause: a cause stated with because of is a cause (reads: oblique)
(: becauseof_cause (Implication (BecauseOf $e $x) (Because $e $x)) (CTV (STV 1.0 0.99) (STV 0.0 0.0)))
;; dueto_cause: a cause stated with due to is a cause (reads: oblique)
(: dueto_cause (Implication (DueTo $e $x) (Because $e $x)) (CTV (STV 1.0 0.99) (STV 0.0 0.0)))
;; owingto_cause: a cause stated with owing to is a cause (reads: oblique)
(: owingto_cause (Implication (OwingTo $e $x) (Because $e $x)) (CTV (STV 1.0 0.99) (STV 0.0 0.0)))
;; thanksto_cause: a cause stated with thanks to is a cause (reads: oblique)
(: thanksto_cause (Implication (ThanksTo $e $x) (Because $e $x)) (CTV (STV 1.0 0.99) (STV 0.0 0.0)))
;; onaccountof_cause: a cause stated with on account of is a cause (reads: oblique)
(: onaccountof_cause (Implication (OnAccountOf $e $x) (Because $e $x)) (CTV (STV 1.0 0.99) (STV 0.0 0.0)))
