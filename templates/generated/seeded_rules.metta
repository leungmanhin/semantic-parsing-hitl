;; The catalog's background rules, lowered for the chainer from rules.yaml — generated by
;; `python -m tmpl.rules`; never edited by hand. Loaded beside the emitted statements by a
;; consumer, never by the parser. Each rule is a deductive implication with an explicit
;; conditional truth value: the positive branch is the rule's reliability, the negative branch
;; (STV 0.0 1.0) says nothing follows from a failed premise.

;; result_holds: a change's named result holds afterwards (reads: change-of-state)
(: result_holds (Implication (Result $e (Member $x $s)) (Member $x $s)) (CTV (STV 1.0 0.9) (STV 0.0 1.0)))
;; coref_sym: a coreference link holds in both directions (reads: coref)
(: coref_sym (Implication (Coref $a $b) (Coref $b $a)) (CTV (STV 1.0 0.99) (STV 0.0 1.0)))
;; coref_agent: a mention's Agent role holds of its antecedent (reads: coref)
(: coref_agent (Implication (And (Coref $m $a) (Agent $e $m)) (Agent $e $a)) (CTV (STV 1.0 0.99) (STV 0.0 1.0)))
;; coref_patient: a mention's Patient role holds of its antecedent (reads: coref)
(: coref_patient (Implication (And (Coref $m $a) (Patient $e $m)) (Patient $e $a)) (CTV (STV 1.0 0.99) (STV 0.0 1.0)))
;; coref_theme: a mention's Theme role holds of its antecedent (reads: coref)
(: coref_theme (Implication (And (Coref $m $a) (Theme $e $m)) (Theme $e $a)) (CTV (STV 1.0 0.99) (STV 0.0 1.0)))
;; coref_recipient: a mention's Recipient role holds of its antecedent (reads: coref)
(: coref_recipient (Implication (And (Coref $m $a) (Recipient $e $m)) (Recipient $e $a)) (CTV (STV 1.0 0.99) (STV 0.0 1.0)))
;; coref_experiencer: a mention's Experiencer role holds of its antecedent (reads: coref)
(: coref_experiencer (Implication (And (Coref $m $a) (Experiencer $e $m)) (Experiencer $e $a)) (CTV (STV 1.0 0.99) (STV 0.0 1.0)))
;; coref_stimulus: a mention's Stimulus role holds of its antecedent (reads: coref)
(: coref_stimulus (Implication (And (Coref $m $a) (Stimulus $e $m)) (Stimulus $e $a)) (CTV (STV 1.0 0.99) (STV 0.0 1.0)))
;; coref_holder: a mention's Holder role holds of its antecedent (reads: coref)
(: coref_holder (Implication (And (Coref $m $a) (Holder $e $m)) (Holder $e $a)) (CTV (STV 1.0 0.99) (STV 0.0 1.0)))
;; coref_goal: a mention's Goal role holds of its antecedent (reads: coref)
(: coref_goal (Implication (And (Coref $m $a) (Goal $e $m)) (Goal $e $a)) (CTV (STV 1.0 0.99) (STV 0.0 1.0)))
;; coref_source: a mention's Source role holds of its antecedent (reads: coref)
(: coref_source (Implication (And (Coref $m $a) (Source $e $m)) (Source $e $a)) (CTV (STV 1.0 0.99) (STV 0.0 1.0)))
;; coref_location: a mention's Location role holds of its antecedent (reads: coref)
(: coref_location (Implication (And (Coref $m $a) (Location $e $m)) (Location $e $a)) (CTV (STV 1.0 0.99) (STV 0.0 1.0)))
;; coref_member: a mention's class or property holds of its antecedent (reads: coref)
(: coref_member (Implication (And (Coref $m $a) (Member $m $k)) (Member $a $k)) (CTV (STV 1.0 0.99) (STV 0.0 1.0)))
;; coref_possession: what a mention possesses, its antecedent possesses (reads: coref)
(: coref_possession (Implication (And (Coref $m $a) (Possession $x $m)) (Possession $x $a)) (CTV (STV 1.0 0.99) (STV 0.0 1.0)))
;; coref_locatedin: where a mention is, its antecedent is (reads: coref)
(: coref_locatedin (Implication (And (Coref $m $a) (LocatedIn $m $p)) (LocatedIn $a $p)) (CTV (STV 1.0 0.99) (STV 0.0 1.0)))
;; days_before_day: a time n days before an anchor has the anchor's day number minus n (reads: time, reference-time)
(: days_before_day (Implication (And (BeforeBy $t $a $n day) (Day $a $d) (Compute - ($d $n) -> $e)) (Day $t $e)) (CTV (STV 1.0 0.99) (STV 0.0 1.0)))
;; days_after_day: a time n days after an anchor has the anchor's day number plus n (reads: time, reference-time)
(: days_after_day (Implication (And (BeforeBy $a $t $n day) (Day $a $d) (Compute + ($d $n) -> $e)) (Day $t $e)) (CTV (STV 1.0 0.99) (STV 0.0 1.0)))
;; days_before_month: a time some days before an anchor is in the anchor's month (reads: time, reference-time)
(: days_before_month (Implication (And (BeforeBy $t $a $n day) (Month $a $m)) (Month $t $m)) (CTV (STV 1.0 0.9) (STV 0.0 1.0)))
;; days_before_year: a time some days before an anchor is in the anchor's year (reads: time, reference-time)
(: days_before_year (Implication (And (BeforeBy $t $a $n day) (Year $a $y)) (Year $t $y)) (CTV (STV 1.0 0.9) (STV 0.0 1.0)))
;; days_after_month: a time some days after an anchor is in the anchor's month (reads: time, reference-time)
(: days_after_month (Implication (And (BeforeBy $a $t $n day) (Month $a $m)) (Month $t $m)) (CTV (STV 1.0 0.9) (STV 0.0 1.0)))
;; days_after_year: a time some days after an anchor is in the anchor's year (reads: time, reference-time)
(: days_after_year (Implication (And (BeforeBy $a $t $n day) (Year $a $y)) (Year $t $y)) (CTV (STV 1.0 0.9) (STV 0.0 1.0)))
;; theme_entailed: an entailing event's sealed Theme holds, at the event's tense (reads: control, causative, aspectual) — 3 variants, by the matrix event's tense
(: theme_entailed (Implication (And (Entails $m) (Theme $m $c) (Compute clause-event ($c) -> $o)) $c) (CTV (STV 1.0 0.9) (STV 0.0 1.0)))
(: theme_entailed_past (Implication (And (Entails $m) (Theme $m $c) (Past $m) (Compute clause-event ($c) -> $o)) (And $c (Past $o))) (CTV (STV 1.0 0.9) (STV 0.0 1.0)))
(: theme_entailed_future (Implication (And (Entails $m) (Theme $m $c) (Future $m) (Compute clause-event ($c) -> $o)) (And $c (Future $o))) (CTV (STV 1.0 0.9) (STV 0.0 1.0)))
;; theme_precluded: a precluding event's sealed Theme does not hold, at the event's tense (reads: control, causative) — 3 variants, by the matrix event's tense
(: theme_precluded (Implication (And (Precludes $m) (Theme $m $c) (Compute clause-event ($c) -> $o)) (Not $c)) (CTV (STV 1.0 0.9) (STV 0.0 1.0)))
(: theme_precluded_past (Implication (And (Precludes $m) (Theme $m $c) (Past $m) (Compute clause-event ($c) -> $o)) (Not (And $c (Past $o)))) (CTV (STV 1.0 0.9) (STV 0.0 1.0)))
(: theme_precluded_future (Implication (And (Precludes $m) (Theme $m $c) (Future $m) (Compute clause-event ($c) -> $o)) (Not (And $c (Future $o)))) (CTV (STV 1.0 0.9) (STV 0.0 1.0)))
