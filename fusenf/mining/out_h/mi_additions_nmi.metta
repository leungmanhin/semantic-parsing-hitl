;;   alignment: $e0=$e0 (holds in 13 of 13 records)   B is part of A: the rule is A's own pack; 5 of the shared records duplicate another
(Implication (And (Member $e0 build) (Patient $e0 $x0)) (MnBuild_Patient $e0 $x0))

